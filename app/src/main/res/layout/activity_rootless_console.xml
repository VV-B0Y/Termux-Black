<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/rootless_console_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/black"
        android:padding="6dp">

        <TextView
            android:id="@+id/rootless_console_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="@android:color/white"
            android:textIsSelectable="true" />
    </ScrollView>

    <!-- Key row: airodump-ng and friends are full-screen TUI programs, so without ESC/TAB/arrows
         and a real Ctrl+C the console cannot drive them at all. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/console_key_esc"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/rootless_key_esc"
                android:textSize="11sp" />

            <Button
                android:id="@+id/console_key_ctrl"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/rootless_key_ctrl"
                android:textSize="11sp" />

            <Button
                android:id="@+id/console_key_ctrlc"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/rootless_key_ctrlc"
                android:textSize="11sp" />

            <Button
                android:id="@+id/console_key_tab"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/rootless_key_tab"
                android:textSize="11sp" />

            <Button
                android:id="@+id/console_key_up"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/rootless_key_up"
                android:textSize="11sp" />

            <Button
                android:id="@+id/console_key_down"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/rootless_key_down"
                android:textSize="11sp" />

            <Button
                android:id="@+id/console_key_left"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/rootless_key_left"
                android:textSize="11sp" />

            <Button
                android:id="@+id/console_key_right"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/rootless_key_right"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp">

        <EditText
            android:id="@+id/rootless_console_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:hint="@string/rootless_console_hint"
            android:importantForAutofill="no"
            android:imeOptions="actionSend"
            android:inputType="textNoSuggestions"
            android:textSize="12sp" />

        <Button
            android:id="@+id/rootless_console_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rootless_console_send" />
    </LinearLayout>
</LinearLayout>
